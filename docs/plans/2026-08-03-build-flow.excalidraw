   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the reviewing eyes see ONLY the work order and the change \u2014 no build\ncontext, no session memory. the builder's own context is what blinds\nit. once per goal, never routinely per piece.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the reviewing eyes see ONLY the work order and the change \u2014 no build\ncontext, no session memory. the builder's own context is what blinds\nit. once per goal, never routinely per piece.",
   "autoResize": true,
   "lineHeight": 1.25
  },
