   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "VISUAL: if sensei is\ninvoked, the pattern's\nown diagram, conforming\nto that pattern's rules,\nwith measurements.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "VISUAL: if sensei is\ninvoked, the pattern's\nown diagram, conforming\nto that pattern's rules,\nwith measurements.",
   "autoResize": true,
   "lineHeight": 1.25
  },
