   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "same destination for both. the KILLER ASSUMPTION differs; the test does not.\n  IDEA BRIEF        \u2014 is the need real, and can we win?\n  PROBLEM STATEMENT \u2014 is the cause correctly located, and is closing the\n                      gap worth what it costs?\na problem statement going straight to DESIGN is the jump-to-countermeasure\nfailure. the risk is HIGHEST on that route, so it is the last place to skip.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "same destination for both. the KILLER ASSUMPTION differs; the test does not.\n  IDEA BRIEF        \u2014 is the need real, and can we win?\n  PROBLEM STATEMENT \u2014 is the cause correctly located, and is closing the\n                      gap worth what it costs?\na problem statement going straight to DESIGN is the jump-to-countermeasure\nfailure. the risk is HIGHEST on that route, so it is the last place to skip.",
   "autoResize": true,
   "lineHeight": 1.25
  },
