   "roundness": null,
   "text": "what it is\nwhat it must become\nwhat gap it addresses\nhow it compares to other\n  products / competitors\nits value\na viability SIGNAL\n  \u2014 not a verdict\nthe next stage's inputs",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
