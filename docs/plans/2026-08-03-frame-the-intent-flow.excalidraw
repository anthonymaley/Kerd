  {
   "id": "t1049",
   "type": "text",
   "x": 678,
   "y": 1004,
   "width": 514.8000000000001,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
