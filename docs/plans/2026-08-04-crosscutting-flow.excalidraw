   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "SYSTEM-WIDE PROPERTY \u2014 THE ROLE LADDER: every blocker, question and refusal anywhere rides ONE\nladder \u2014 answered at the lowest role with the knowledge AND the authority, escalated only on genuine\ninability; the human is the last rung. three callers surfaced it: the contract's escalation, the loop's\nquestions, the gate's refusals.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SYSTEM-WIDE PROPERTY \u2014 THE ROLE LADDER: every blocker, question and refusal anywhere rides ONE\nladder \u2014 answered at the lowest role with the knowledge AND the authority, escalated only on genuine\ninability; the human is the last rung. three callers surfaced it: the contract's escalation, the loop's\nquestions, the gate's refusals.",
   "autoResize": true,
   "lineHeight": 1.25
  },
