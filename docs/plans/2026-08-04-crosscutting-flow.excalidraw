  {
   "id": "t1037",
   "type": "text",
   "x": 678,
   "y": 1195,
   "width": 442.20000000000005,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
