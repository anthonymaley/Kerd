   },
   "roundness": null,
   "text": "checks the DECLARED inputs of the rung about to start \u2014 mechanical:\ndeclarations exist on disk or they don't \u2014 and names exactly what is\nmissing. the refusal is not its own mechanism: it rides the LADDER\nas a question the spec cannot answer. renders via Show where we are,\nnever a view of its own. honours a declared SPIKE as the one\nlicensed bypass.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "checks the DECLARED inputs of the rung about to start \u2014 mechanical:\ndeclarations exist on disk or they don't \u2014 and names exactly what is\nmissing. the refusal is not its own mechanism: it rides the LADDER\nas a question the spec cannot answer. renders via Show where we are,\nnever a view of its own. honours a declared SPIKE as the one\nlicensed bypass.",
   "autoResize": true,
   "lineHeight": 1.25
  },
