      "roundness": null,
      "text": "Nine gates against eight rungs — they do not align",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r1030",
      "originalText": "Nine gates against eight rungs — they do not align",
