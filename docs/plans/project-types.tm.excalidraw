      "version": 2,
      "versionNonce": 1756085873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786150897391,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "none of the three is a\nblocker yet. all three\nare unqualified, which is\nthe dangerous state - a\nnamed unsized risk reads\nas managed.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
