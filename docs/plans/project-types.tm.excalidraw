    },
    {
      "id": "t1032",
      "type": "text",
      "x": 678,
      "y": 1214,
      "width": 429.00000000000006,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
