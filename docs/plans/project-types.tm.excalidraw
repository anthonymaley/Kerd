      "versionNonce": 33416,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "G0 intake qualified          ~ frame\nG1 disposition declared        - NO RUNG\nG2 spec approved             ~ contract\nG3 design approved           = design\nG4 build complete            = build\nG5 verification passed       ~ goal\nG6 security / privacy          - NO RUNG\nG7 launch readiness            - NO RUNG\nG8 post-launch evidence      = loop  (the stage left EMPTY)\n                               - viability and slice have NO GATE",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "G0 intake qualified          ~ frame\nG1 disposition declared        - NO RUNG\nG2 spec approved             ~ contract\nG3 design approved           = design\nG4 build complete            = build\nG5 verification passed       ~ goal\nG6 security / privacy          - NO RUNG\nG7 launch readiness            - NO RUNG\nG8 post-launch evidence      = loop  (the stage left EMPTY)\n                               - viability and slice have NO GATE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1033",
      "type": "text",
      "x": 1320,
      "y": 1150,
      "width": 165,
      "height": 105,
      "angle": 0,
      "strokeColor": "#e03131",
