   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "a tag assigned during planning measures how hard the piece FELT to\nplan, not what judgment survived being written down. write the piece\nin full, then read it and ask what decision is still left in it.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a tag assigned during planning measures how hard the piece FELT to\nplan, not what judgment survived being written down. write the piece\nin full, then read it and ask what decision is still left in it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
