    {
      "id": "t1080",
      "type": "text",
      "x": 325,
      "y": 1746,
      "width": 734.2500000000001,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
