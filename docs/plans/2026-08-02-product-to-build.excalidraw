    {
      "id": "t1361",
      "type": "text",
      "x": 670,
      "y": 8519,
      "width": 493.35,
      "height": 260.0,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0361",
      "roundness": null,
      "seed": 19527,
      "version": 1,
      "versionNonce": 37693,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "MUST produce ONE package: detailed specs, architecture plans, testing\nstrategy \u2014 and diagrams for as many aspects as we can. agreed in\ndiagrams, not prose.\nMUST propose at least two approaches with trade-offs before one is\nchosen \u2014 options on constant axes, costs marked, bets named, resolved\nin ONE message, not a sequence of clarifications.\nMUST be approved before any build starts, on TWO KEYS: every aspect\ndrawn and nothing left to annotate \u00b7 every stage-1 measurement has a\nNAMED ANSWER in the package. the measuring itself is post-build.\nMUST live at docs/design/<slug> \u2014 living, undated, same slug as the\nproduct doc. GO writes a dated gate record and hands to CONTRACT,\nnever to a plan-writing skill.\nMUST state test bias per layer, and name every seam needing a\ncontract test.\n(?) MUST output interface values a machine can check \u2014 tokens, hex,\nspacing, states",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MUST produce ONE package: detailed specs, architecture plans, testing\nstrategy \u2014 and diagrams for as many aspects as we can. agreed in\ndiagrams, not prose.\nMUST propose at least two approaches with trade-offs before one is\nchosen \u2014 options on constant axes, costs marked, bets named, resolved\nin ONE message, not a sequence of clarifications.\nMUST be approved before any build starts, on TWO KEYS: every aspect\ndrawn and nothing left to annotate \u00b7 every stage-1 measurement has a\nNAMED ANSWER in the package. the measuring itself is post-build.\nMUST live at docs/design/<slug> \u2014 living, undated, same slug as the\nproduct doc. GO writes a dated gate record and hands to CONTRACT,\nnever to a plan-writing skill.\nMUST state test bias per layer, and name every seam needing a\ncontract test.\n(?) MUST output interface values a machine can check \u2014 tokens, hex,\nspacing, states",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
