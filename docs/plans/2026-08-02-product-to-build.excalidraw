    {
      "id": "t1350",
      "type": "text",
      "x": 670,
      "y": 7921,
      "width": 514.8000000000001,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0350",
      "roundness": null,
      "seed": 19450,
      "version": 1,
      "versionNonce": 37550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "CUT. the code is the truth for mechanism and sequencing; a parallel\ndocument is a second source that drifts. the one measured failure behind\nthis function was RETRIEVAL, not absence \u2014 the document existed.\nwhat survives goes elsewhere: retrieval is the 'reachable' clause of\nWhere the work is written down; intent and value are already produced\nby Frame the intent.\nRETURN CONDITION: a question arises that the code cannot answer.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CUT. the code is the truth for mechanism and sequencing; a parallel\ndocument is a second source that drifts. the one measured failure behind\nthis function was RETRIEVAL, not absence \u2014 the document existed.\nwhat survives goes elsewhere: retrieval is the 'reachable' clause of\nWhere the work is written down; intent and value are already produced\nby Frame the intent.\nRETURN CONDITION: a question arises that the code cannot answer.",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
