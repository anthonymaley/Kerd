        "gen": "kerd"
      }
    },
    {
      "id": "t1353",
      "type": "text",
      "x": 670,
      "y": 8054,
      "width": 521.95,
      "height": 178.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0353",
      "roundness": null,
      "seed": 19471,
      "version": 1,
      "versionNonce": 37589,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "a release is a GROUPING, not a time axis \u2014 time may be attached later, or\nnever. ordering and scheduling are separable.\nMUST respect dependencies as HARD constraints, and MUST cap the slice at\nwhat a user can absorb at once \u2014 a release can be too big even when\neverything in it is finished.\nMUST consume the qualified risks from Test viability rather than\nre-assessing them.\nThe DONE condition MUST be ASSEMBLED from upstream declarations, never\nauthored at the end: every item is a conformance check against something\nalready declared. MUST NOT contain an item nothing declared \u2014 it cannot\nbe checked, so it passes by assertion.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a release is a GROUPING, not a time axis \u2014 time may be attached later, or\nnever. ordering and scheduling are separable.\nMUST respect dependencies as HARD constraints, and MUST cap the slice at\nwhat a user can absorb at once \u2014 a release can be too big even when\neverything in it is finished.\nMUST consume the qualified risks from Test viability rather than\nre-assessing them.\nThe DONE condition MUST be ASSEMBLED from upstream declarations, never\nauthored at the end: every item is a conformance check against something\nalready declared. MUST NOT contain an item nothing declared \u2014 it cannot\nbe checked, so it passes by assertion.",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
