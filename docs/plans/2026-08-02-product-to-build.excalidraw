    {
      "id": "t1347",
      "type": "text",
      "x": 670,
      "y": 7771,
      "width": 521.95,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
