      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "DESIGN RUNG \u2014 genuinely missing, and the one conductor reached outside for.\n   Not sherpa (staging), not interrogate (viability), not capturerequirements (MVP reqs).\n   None of the four dead skills is a design step. Routing would not have filled this.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DESIGN RUNG \u2014 genuinely missing, and the one conductor reached outside for.\n   Not sherpa (staging), not interrogate (viability), not capturerequirements (MVP reqs).\n   None of the four dead skills is a design step. Routing would not have filled this.",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
    {
      "id": "t1081",
      "type": "text",
      "x": 325,
      "y": 1834,
      "width": 676.5,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
