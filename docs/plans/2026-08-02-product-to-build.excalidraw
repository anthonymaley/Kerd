      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "What we ruled out, and why",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r1406",
      "originalText": "What we ruled out, and why",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
    {
      "id": "t1408",
      "type": "text",
      "x": 670,
      "y": 10360,
      "width": 543.4000000000001,
      "height": 211.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0408",
      "roundness": null,
      "seed": 19856,
      "version": 1,
      "versionNonce": 38304,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "MUST be its OWN artifact, reviewable in one pass \u2014 inside each solution doc,\n'what have we already ruled out?' cannot be answered without reading all\nof them.\nMUST record the CONCEPT, not the code: what was tried or considered, why\nit was eliminated, the evidence (a test OR an analysis \u2014 the same thing,\ndiffering in cost), and the condition that would bring it back.\nMUST be read in GROUNDING by every function that proposes anything. that\nis what stops a dead option being re-proposed, and it is why this is not\na graveyard but an input.\nMUST be captured as a BYPRODUCT of work already happening \u2014 a failed\nverify IS the record. an artifact needing discipline to maintain goes\nstale, and a stale 'already tried' list is worse than none.\nMUST NOT record slips. the filter is: was it ever a candidate?",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MUST be its OWN artifact, reviewable in one pass \u2014 inside each solution doc,\n'what have we already ruled out?' cannot be answered without reading all\nof them.\nMUST record the CONCEPT, not the code: what was tried or considered, why\nit was eliminated, the evidence (a test OR an analysis \u2014 the same thing,\ndiffering in cost), and the condition that would bring it back.\nMUST be read in GROUNDING by every function that proposes anything. that\nis what stops a dead option being re-proposed, and it is why this is not\na graveyard but an input.\nMUST be captured as a BYPRODUCT of work already happening \u2014 a failed\nverify IS the record. an artifact needing discipline to maintain goes\nstale, and a stale 'already tried' list is worse than none.\nMUST NOT record slips. the filter is: was it ever a candidate?",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
