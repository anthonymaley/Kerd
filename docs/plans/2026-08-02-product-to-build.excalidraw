      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "MUST measure each piece against ALL RELEVANT specs and measurements \u2014\nits own criteria plus everything its change touches, relevance scoped\nby the overseer \u2014 and tests MUST match the acceptance criteria / goal.\ncollateral is covered by 'relevant': damage beside the piece shows up.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MUST measure each piece against ALL RELEVANT specs and measurements \u2014\nits own criteria plus everything its change touches, relevance scoped\nby the overseer \u2014 and tests MUST match the acceptance criteria / goal.\ncollateral is covered by 'relevant': damage beside the piece shows up.",
      "autoResize": true,
