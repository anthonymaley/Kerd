    {
      "id": "t1356",
      "type": "text",
      "x": 670,
      "y": 8252,
      "width": 536.25,
      "height": 195.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0356",
      "roundness": null,
      "seed": 19492,
      "version": 1,
      "versionNonce": 37628,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "text": "MUST present candidates on two constant axes, both about OUTCOME:\nCONSEQUENCE (what it costs us not to do it) and VALUE (what we gain).\nMUST NOT use EFFORT as an axis \u2014 an input measure beside outcome measures\nmakes the grid incoherent and flatters cheap work.\nMUST name, per item, WHAT WE LOSE by not choosing it \u2014 a ranked list shows\nwhat you picked and never what you gave up.\nMUST be RENDERED, with the same structure per item and a clear ask. the\nfailure is not bad ranking, it is items that cannot be weighed: no diagram,\nno structure, no ask.\nMUST separate items BLOCKED on a dependency \u2014 they are not candidates at\nany consequence.\nMUST NOT rank by what fits the session about to run.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MUST present candidates on two constant axes, both about OUTCOME:\nCONSEQUENCE (what it costs us not to do it) and VALUE (what we gain).\nMUST NOT use EFFORT as an axis \u2014 an input measure beside outcome measures\nmakes the grid incoherent and flatters cheap work.\nMUST name, per item, WHAT WE LOSE by not choosing it \u2014 a ranked list shows\nwhat you picked and never what you gave up.\nMUST be RENDERED, with the same structure per item and a clear ask. the\nfailure is not bad ranking, it is items that cannot be weighed: no diagram,\nno structure, no ask.\nMUST separate items BLOCKED on a dependency \u2014 they are not candidates at\nany consequence.\nMUST NOT rank by what fits the session about to run.",
      "autoResize": true,
      "lineHeight": 1.25,
      "customData": {
        "gen": "kerd"
      }
    },
