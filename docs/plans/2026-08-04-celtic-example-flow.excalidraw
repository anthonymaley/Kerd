   "type": "text",
   "x": 678,
   "y": 1718,
   "width": 422.40000000000003,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
