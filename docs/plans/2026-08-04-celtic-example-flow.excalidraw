   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "next unblocked piece \u2192 build \u2192 prove against ALL RELEVANT specs \u2192\ncommit as it verifies \u2192 repeat. the driver holds nothing: state\nlives in the declared artifacts, so it cuts and resumes fresh\nbetween pieces. every question rides the LADDER \u2014 builder \u2192\noverseer \u2192 intent-holder \u2192 you \u2014 and only a role-unanswerable\nblocker reaches you. the liveness view ticks at every piece\nboundary: landed \u00b7 in flight \u00b7 remaining. motion, not 'working\u2026'.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "next unblocked piece \u2192 build \u2192 prove against ALL RELEVANT specs \u2192\ncommit as it verifies \u2192 repeat. the driver holds nothing: state\nlives in the declared artifacts, so it cuts and resumes fresh\nbetween pieces. every question rides the LADDER \u2014 builder \u2192\noverseer \u2192 intent-holder \u2192 you \u2014 and only a role-unanswerable\nblocker reaches you. the liveness view ticks at every piece\nboundary: landed \u00b7 in flight \u00b7 remaining. motion, not 'working\u2026'.",
   "autoResize": true,
   "lineHeight": 1.25
  },
