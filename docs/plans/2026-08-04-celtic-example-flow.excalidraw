   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the design package arrives INTACT \u2014 never a digest. the work\norder: self-contained pieces ('listing service', 'seat-transfer\nflow', 'holder-verification screen'), each carrying its own check,\nsized and assigned AFTER writing. two-tier access: the overseer\nholds all truth; each builder gets exactly its piece plus related\nmaterials. NO human gate \u2014 every piece measurable against an\nupstream declaration, or pushed back to design.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the design package arrives INTACT \u2014 never a digest. the work\norder: self-contained pieces ('listing service', 'seat-transfer\nflow', 'holder-verification screen'), each carrying its own check,\nsized and assigned AFTER writing. two-tier access: the overseer\nholds all truth; each builder gets exactly its piece plus related\nmaterials. NO human gate \u2014 every piece measurable against an\nupstream declaration, or pushed back to design.",
   "autoResize": true,
   "lineHeight": 1.25
  },
