   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "EFFORT \u00b7 RISK \u00b7\nOPPORTUNITY\nTRADE-OFFS\n\nshape the grouping\namong what is left.\nthey do not forbid.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r1023",
   "originalText": "EFFORT \u00b7 RISK \u00b7\nOPPORTUNITY\nTRADE-OFFS\n\nshape the grouping\namong what is left.\nthey do not forbid.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1025",
   "type": "text",
   "x": 1320,
   "y": 573,
   "width": 356.40000000000003,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0025",
   "seed": 17175,
   "version": 1,
   "versionNonce": 33325,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "THE CEILING IS THE UNUSUAL ONE.\nalmost everything sizes a release by what is READY \u2014\na bound from the producing side. this is a bound from\nthe RECEIVING side: a release can be too big even when\neverything in it is finished.\n\nit is why 'we shipped everything we had' is a real\nfailure mode and not a joke.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "THE CEILING IS THE UNUSUAL ONE.\nalmost everything sizes a release by what is READY \u2014\na bound from the producing side. this is a bound from\nthe RECEIVING side: a release can be too big even when\neverything in it is finished.\n\nit is why 'we shipped everything we had' is a real\nfailure mode and not a joke.",
   "autoResize": true,
   "lineHeight": 1.25
  },
