  {
   "id": "t1045",
   "type": "text",
   "x": 674,
   "y": 1118,
   "width": 429.00000000000006,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0045",
   "seed": 17315,
   "version": 1,
   "versionNonce": 33585,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "met the feature spec          <-  the contract\nmet the product spec          <-  the idea brief\ngoal of the function met      <-  the goal set here\nlooks EXACTLY like design     <-  design, approved before build\ntests pass                    <-  every proof layer declared by\n                                  Decide what proves it \u2014\n                                  INCLUDING user testing\ndocumentation complete        <-  DERIVED, not declared: every\n                                  declaration covered \u2014 feature,\n                                  product and problem specs, the\n                                  changes and fixes implemented,\n                                  the solution diagrams, and what\n                                  we ruled out",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "met the feature spec          <-  the contract\nmet the product spec          <-  the idea brief\ngoal of the function met      <-  the goal set here\nlooks EXACTLY like design     <-  design, approved before build\ntests pass                    <-  every proof layer declared by\n                                  Decide what proves it \u2014\n                                  INCLUDING user testing\ndocumentation complete        <-  DERIVED, not declared: every\n                                  declaration covered \u2014 feature,\n                                  product and problem specs, the\n                                  changes and fixes implemented,\n                                  the solution diagrams, and what\n                                  we ruled out",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1046",
   "type": "text",
   "x": 1320,
   "y": 1118,
   "width": 303.6,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0046",
   "seed": 17322,
   "version": 1,
   "versionNonce": 33598,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "TWO ORPHANS RESOLVED WITHOUT NEW FUNCTIONS.\n'user testing passed' and 'documentation is\ncomplete' had no upstream declaration when\nthis started. user testing turned out to be a\nproof LAYER nobody had listed; documentation\nturned out to be DERIVED rather than declared.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "TWO ORPHANS RESOLVED WITHOUT NEW FUNCTIONS.\n'user testing passed' and 'documentation is\ncomplete' had no upstream declaration when\nthis started. user testing turned out to be a\nproof LAYER nobody had listed; documentation\nturned out to be DERIVED rather than declared.",
   "autoResize": true,
   "lineHeight": 1.25
  },
