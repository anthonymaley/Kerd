   "index": "a0039",
   "seed": 17273,
   "version": 1,
   "versionNonce": 33507,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "this is why the draft\nwas circular. 'specific\nenough to terminate a\nloop' is true EXACTLY\nwhen every item points\nat a declaration that\nexists.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "this is why the draft\nwas circular. 'specific\nenough to terminate a\nloop' is true EXACTLY\nwhen every item points\nat a declaration that\nexists.",
   "autoResize": true,
   "lineHeight": 1.25
  },
