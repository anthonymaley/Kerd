   },
   "roundness": null,
   "text": "the DONE condition is ASSEMBLED, never authored. you do not write a\nwish list at the end \u2014 you walk what each rung already declared.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the DONE condition is ASSEMBLED, never authored. you do not write a\nwish list at the end \u2014 you walk what each rung already declared.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1039",
   "type": "text",
   "x": 1320,
   "y": 916,
   "width": 151.8,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
