   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "none of the three is a\nblocker yet. all three\nare unqualified, which is\nthe dangerous state - a\nnamed unsized risk reads\nas managed.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
