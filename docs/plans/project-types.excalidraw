   "index": "a0025",
   "seed": 17175,
   "version": 1,
   "versionNonce": 33325,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "declared ONCE, at G0 intake:      Project Type: MVP\n\nderived, never declared again:\n   route         Spike -> spike \u00b7 Ideation -> spike \u00b7\n                 Maintenance/Hotfix -> problem \u00b7 rest -> new\n   Rigor level   Spike -> spike \u00b7 MVP/Pilot/Beta -> mvp \u00b7\n                 Full Release/Migration/Platform/Compliance\n                 -> production-v1\n\ntwo legal sets die. one arrives. the system gets SMALLER.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "declared ONCE, at G0 intake:      Project Type: MVP\n\nderived, never declared again:\n   route         Spike -> spike \u00b7 Ideation -> spike \u00b7\n                 Maintenance/Hotfix -> problem \u00b7 rest -> new\n   Rigor level   Spike -> spike \u00b7 MVP/Pilot/Beta -> mvp \u00b7\n                 Full Release/Migration/Platform/Compliance\n                 -> production-v1\n\ntwo legal sets die. one arrives. the system gets SMALLER.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1026",
   "type": "text",
   "x": 1320,
   "y": 864,
   "width": 165.0,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
