   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "G8 is the clean fit. loop\n/ Live was left empty in\nfunnel-steps.md because\nno steps could be found.\ncategory POST gave it\nvocabulary; G8 gives it\na gate.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "G8 is the clean fit. loop\n/ Live was left empty in\nfunnel-steps.md because\nno steps could be found.\ncategory POST gave it\nvocabulary; G8 gives it\na gate.",
   "autoResize": true,
   "lineHeight": 1.25
  },
