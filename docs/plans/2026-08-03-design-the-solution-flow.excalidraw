   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "HUMAN:   every aspect Tony cares about is DRAWN, he has reviewed the\n         drawings, and NOTHING IS LEFT TO ANNOTATE.\nMACHINE: every measurement stage 1 declared has a NAMED ANSWER in the\n         package \u2014 point at where the design delivers it. nothing\n         declared upstream goes unaddressed. the MEASURING itself is\n         post-build conformance, not here.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "HUMAN:   every aspect Tony cares about is DRAWN, he has reviewed the\n         drawings, and NOTHING IS LEFT TO ANNOTATE.\nMACHINE: every measurement stage 1 declared has a NAMED ANSWER in the\n         package \u2014 point at where the design delivers it. nothing\n         declared upstream goes unaddressed. the MEASURING itself is\n         post-build conformance, not here.",
   "autoResize": true,
   "lineHeight": 1.25
  },
