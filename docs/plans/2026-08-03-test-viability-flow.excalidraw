   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "two passes, or 'risk-driven, not menu-driven' quietly becomes a full\nrisk register. estimate first, spend evidence second.\n  could plausibly cross the line  \u2192 gather evidence (step 4)\n  clearly cannot                  \u2192 not this rung's problem",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "two passes, or 'risk-driven, not menu-driven' quietly becomes a full\nrisk register. estimate first, spend evidence second.\n  could plausibly cross the line  \u2192 gather evidence (step 4)\n  clearly cannot                  \u2192 not this rung's problem",
   "autoResize": true,
   "lineHeight": 1.25
  },
