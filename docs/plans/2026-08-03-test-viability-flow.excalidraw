   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "a countermeasure is a HYPOTHESIS \u2014 'I believe X will address Y because\nZ' \u2014 so it must state what it is expected to do, or nothing can check\nlater whether it worked.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a countermeasure is a HYPOTHESIS \u2014 'I believe X will address Y because\nZ' \u2014 so it must state what it is expected to do, or nothing can check\nlater whether it worked.",
   "autoResize": true,
   "lineHeight": 1.25
  },
