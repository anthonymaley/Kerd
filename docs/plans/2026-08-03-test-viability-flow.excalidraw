   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0089",
   "seed": 17623,
   "version": 1,
   "versionNonce": 34157,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "OPEN on this stage \u2014 accepted risks age, and nothing brings them back.\nA TEMPORARY countermeasure is self-expiring: it carries its own return condition, so that class is answered.\nThe other two are not. An ACCEPTED UNKNOWN was accepted because evidence was too expensive \u2014 evidence gets\ncheaper. A LOW-LIKELIHOOD FATAL was accepted at one moment's odds \u2014 odds move. Today both are permanent by\ndefault, which is the same shape as the design doc that held the answer and went unread: right when decided,\nand nothing brings it back.",
   "fontSize": 15,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "OPEN on this stage \u2014 accepted risks age, and nothing brings them back.\nA TEMPORARY countermeasure is self-expiring: it carries its own return condition, so that class is answered.\nThe other two are not. An ACCEPTED UNKNOWN was accepted because evidence was too expensive \u2014 evidence gets\ncheaper. A LOW-LIKELIHOOD FATAL was accepted at one moment's odds \u2014 odds move. Today both are permanent by\ndefault, which is the same shape as the design doc that held the answer and went unread: right when decided,\nand nothing brings it back.",
   "autoResize": true,
   "lineHeight": 1.25
  }
