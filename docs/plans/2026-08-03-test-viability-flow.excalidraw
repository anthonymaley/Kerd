   "roundness": null,
   "text": "carries the surviving risks and their countermeasures forward. design\nbuilds AROUND them \u2014 a countermeasure is a constraint on the shape,\nnot a note in a document nobody opens.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "carries the surviving risks and their countermeasures forward. design\nbuilds AROUND them \u2014 a countermeasure is a constraint on the shape,\nnot a note in a document nobody opens.",
