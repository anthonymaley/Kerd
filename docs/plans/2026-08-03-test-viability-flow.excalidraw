   "versionNonce": 33611,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "DO NOT MULTIPLY THEM.\nexpected value is the wrong maths for a bet you\ntake once \u2014 a 5% chance of ending the thing is\nnot 5% of the damage. you do not get to average\nacross a single non-repeated outcome.\n\nFATAL = impact >= the VALUE framing declared,\nat ANY likelihood. likelihood sets the RESPONSE,\nnot the classification.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "DO NOT MULTIPLY THEM.\nexpected value is the wrong maths for a bet you\ntake once \u2014 a 5% chance of ending the thing is\nnot 5% of the damage. you do not get to average\nacross a single non-repeated outcome.\n\nFATAL = impact >= the VALUE framing declared,\nat ANY likelihood. likelihood sets the RESPONSE,\nnot the classification.",
   "autoResize": true,
   "lineHeight": 1.25
  },
