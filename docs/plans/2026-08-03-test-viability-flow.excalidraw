   },
   "roundness": null,
   "text": "EVIDENCE \u2014 what qualifies a risk",
   "fontSize": 14,
   "fontFamily": 6,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r1036",
   "originalText": "EVIDENCE \u2014 what qualifies a risk",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1038",
   "type": "text",
   "x": 678,
   "y": 980,
   "width": 442.20000000000005,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0038",
   "seed": 17266,
   "version": 1,
   "versionNonce": 33494,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "whichever is cheaper AND would actually change the decision:\n  A TEST      \u2014 run something. empirical.\n  AN ANALYSIS \u2014 prove it from what is already known. also evidence,\n                and usually the cheapest. not everything needs\n                an experiment.\nwithout evidence you cannot dispose of a risk \u2014 only feel better\nabout it.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "whichever is cheaper AND would actually change the decision:\n  A TEST      \u2014 run something. empirical.\n  AN ANALYSIS \u2014 prove it from what is already known. also evidence,\n                and usually the cheapest. not everything needs\n                an experiment.\nwithout evidence you cannot dispose of a risk \u2014 only feel better\nabout it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1039",
   "type": "text",
   "x": 1320,
   "y": 916,
   "width": 151.8,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0039",
   "seed": 17273,
   "version": 1,
   "versionNonce": 33507,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the evidence is an\nartifact, not a memory.\na qualified risk POINTS\nAT what qualified it.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the evidence is an\nartifact, not a memory.\na qualified risk POINTS\nAT what qualified it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
