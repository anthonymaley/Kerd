  {
   "id": "t1081",
   "type": "text",
   "x": 1320,
   "y": 1904,
   "width": 343.20000000000005,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0081",
   "seed": 17567,
   "version": 1,
   "versionNonce": 34053,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "HIGH IMPACT + HIGH LIKELIHOOD + NO COUNTERMEASURE\n= DEAD PROJECT. not a kill you choose \u2014 a state you\nrecognise. the thing is already dead; the only\nquestion is how long before someone says so.\n\nTHIS IS THE LIMIT ON ACCEPTANCE. every other blocker\ncan be accepted by name. this one cannot, or\n'accept by name' becomes an escape hatch for\nanything. the only moves left are RESHAPE \u2014 change\nthe thing so the risk is no longer fatal \u2014 or KILL.\n\na kill here is a SUCCESS: it is the cheapest place\nthe thing can die.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "HIGH IMPACT + HIGH LIKELIHOOD + NO COUNTERMEASURE\n= DEAD PROJECT. not a kill you choose \u2014 a state you\nrecognise. the thing is already dead; the only\nquestion is how long before someone says so.\n\nTHIS IS THE LIMIT ON ACCEPTANCE. every other blocker\ncan be accepted by name. this one cannot, or\n'accept by name' becomes an escape hatch for\nanything. the only moves left are RESHAPE \u2014 change\nthe thing so the risk is no longer fatal \u2014 or KILL.\n\na kill here is a SUCCESS: it is the cheapest place\nthe thing can die.",
   "autoResize": true,
   "lineHeight": 1.25
  },
