   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "A RISK WITHOUT A COUNTERMEASURE IS A BLOCKER.\nthat is the DEFAULT \u2014 so silence stops the work\ninstead of passing it, which is the whole point.\n\na blocker clears ONE way: an explicit act of\nacceptance. who, when, on what basis. an\nACCEPTED UNKNOWN is a blocker accepted without\neven knowing its size \u2014 allowed, never by default.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A RISK WITHOUT A COUNTERMEASURE IS A BLOCKER.\nthat is the DEFAULT \u2014 so silence stops the work\ninstead of passing it, which is the whole point.\n\na blocker clears ONE way: an explicit act of\nacceptance. who, when, on what basis. an\nACCEPTED UNKNOWN is a blocker accepted without\neven knowing its size \u2014 allowed, never by default.",
   "autoResize": true,
   "lineHeight": 1.25
  },
