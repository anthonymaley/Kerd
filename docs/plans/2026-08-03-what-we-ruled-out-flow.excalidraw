   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "what was tried or considered  \u00b7  why it was eliminated  \u00b7  the evidence\n(a test OR an analysis)  \u00b7  and the CONDITION that would bring it back.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "what was tried or considered  \u00b7  why it was eliminated  \u00b7  the evidence\n(a test OR an analysis)  \u00b7  and the CONDITION that would bring it back.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1026",
   "type": "text",
   "x": 1320,
   "y": 660,
   "width": 178.20000000000002,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
