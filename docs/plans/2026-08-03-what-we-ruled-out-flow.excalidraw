   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "How does it get captured?",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r1030",
   "originalText": "How does it get captured?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1032",
   "type": "text",
   "x": 678,
   "y": 874,
   "width": 468.6,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0032",
   "seed": 17224,
   "version": 1,
   "versionNonce": 33416,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "capture MUST be a byproduct of work already happening \u2014 never a\nseparate act of discipline.\n  BUILD-LEVEL  \u2014 a failed verify IS the record. conductor already runs\n                 a verify per step and hands back after three failures.\n  DESIGN-LEVEL \u2014 hand-written. rare enough to afford it.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "capture MUST be a byproduct of work already happening \u2014 never a\nseparate act of discipline.\n  BUILD-LEVEL  \u2014 a failed verify IS the record. conductor already runs\n                 a verify per step and hands back after three failures.\n  DESIGN-LEVEL \u2014 hand-written. rare enough to afford it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1033",
   "type": "text",
   "x": 674,
   "y": 979,
   "width": 402.6,
   "height": 240.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0033",
   "seed": 17231,
   "version": 1,
   "versionNonce": 33429,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "RUN THROUGH TEST VIABILITY'S OWN MACHINERY:\n\n  RISK         the record is not maintained at volume\n  IMPACT       high \u2014 a stale 'already tried' list is WORSE\n               than none. it answers confidently and wrongly.\n               that is the exact argument that killed\n               Hold product truth.\n  LIKELIHOOD   high \u2014 the standard fate of any log needing\n               discipline to maintain.\n  COUNTERMEASURE   none, at first pass.\n\n  = HIGH IMPACT + HIGH LIKELIHOOD + NO COUNTERMEASURE\n  = DEAD PROJECT, by the rule set an hour earlier.\n\nso BYPRODUCT CAPTURE is not an optimisation. it is the\ncondition of this artifact existing at all.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "RUN THROUGH TEST VIABILITY'S OWN MACHINERY:\n\n  RISK         the record is not maintained at volume\n  IMPACT       high \u2014 a stale 'already tried' list is WORSE\n               than none. it answers confidently and wrongly.\n               that is the exact argument that killed\n               Hold product truth.\n  LIKELIHOOD   high \u2014 the standard fate of any log needing\n               discipline to maintain.\n  COUNTERMEASURE   none, at first pass.\n\n  = HIGH IMPACT + HIGH LIKELIHOOD + NO COUNTERMEASURE\n  = DEAD PROJECT, by the rule set an hour earlier.\n\nso BYPRODUCT CAPTURE is not an optimisation. it is the\ncondition of this artifact existing at all.",
   "autoResize": true,
   "lineHeight": 1.25
  },
