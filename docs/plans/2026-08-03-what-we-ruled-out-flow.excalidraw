   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the four callers:\n  gaps that could not be\n  closed (Frame the intent)\n  accepted unknowns and\n  blockers (Test viability)\n  work we discounted\n  (Slice a release)\n  what was deliberately\n  not built (from cutting\n  Hold product truth)",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the four callers:\n  gaps that could not be\n  closed (Frame the intent)\n  accepted unknowns and\n  blockers (Test viability)\n  work we discounted\n  (Slice a release)\n  what was deliberately\n  not built (from cutting\n  Hold product truth)",
   "autoResize": true,
   "lineHeight": 1.25
  },
