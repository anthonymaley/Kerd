  {
   "id": "t1031",
   "type": "text",
   "x": 863.75,
   "y": 827.25,
   "width": 192.50000000000003,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
