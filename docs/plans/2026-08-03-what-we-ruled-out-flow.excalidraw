  {
   "id": "t1018",
   "type": "text",
   "x": 678,
   "y": 540,
   "width": 429.00000000000006,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
