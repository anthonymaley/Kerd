  {
   "id": "t1076",
   "type": "text",
   "x": 300,
   "y": 1166,
   "width": 836.5500000000001,
   "height": 113.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0076",
   "seed": 17532,
   "version": 1,
   "versionNonce": 33988,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "\u00b7 CI is HIGH on BOTH, and alone in that. it does not merely guard the work \u2014 /loop cannot run at all where\n  nothing can refuse, so it GATES the loop. nothing else on the board unblocks a whole capability.\n\u00b7 'Repin the three repos' is HIGH CONSEQUENCE, NO VALUE \u2014 pure hygiene. under the first cut (effort x consequence)\n  it read as a cheap win and rose. swapping effort for value demoted it correctly: it prevents harm, it adds nothing.\n\u00b7 'The SPIKE' rose for the same reason, in reverse \u2014 medium consequence, HIGH value, because one cheap test\n  settles the fate of four dead skills. effort had hidden that entirely.\n\u00b7 the LOSS column is what makes the bottom band safe to ignore. you can see the cost of ignoring it.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u00b7 CI is HIGH on BOTH, and alone in that. it does not merely guard the work \u2014 /loop cannot run at all where\n  nothing can refuse, so it GATES the loop. nothing else on the board unblocks a whole capability.\n\u00b7 'Repin the three repos' is HIGH CONSEQUENCE, NO VALUE \u2014 pure hygiene. under the first cut (effort x consequence)\n  it read as a cheap win and rose. swapping effort for value demoted it correctly: it prevents harm, it adds nothing.\n\u00b7 'The SPIKE' rose for the same reason, in reverse \u2014 medium consequence, HIGH value, because one cheap test\n  settles the fate of four dead skills. effort had hidden that entirely.\n\u00b7 the LOSS column is what makes the bottom band safe to ignore. you can see the cost of ignoring it.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1077",
   "type": "text",
   "x": 300,
   "y": 1296,
   "width": 870.1,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0077",
   "seed": 17539,
   "version": 1,
   "versionNonce": 34001,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "WHY EFFORT WAS WRONG: it is an INPUT measure sitting beside an OUTCOME measure, which makes the grid incoherent \u2014\nand it systematically flatters cheap work. effort survives as a tiebreaker inside a cell, and as one of the five\nslicing factors at Slice a release. it is not an axis.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WHY EFFORT WAS WRONG: it is an INPUT measure sitting beside an OUTCOME measure, which makes the grid incoherent \u2014\nand it systematically flatters cheap work. effort survives as a tiebreaker inside a cell, and as one of the five\nslicing factors at Slice a release. it is not an axis.",
   "autoResize": true,
   "lineHeight": 1.25
  }
