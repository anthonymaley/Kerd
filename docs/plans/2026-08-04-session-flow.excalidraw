   "roundness": null,
   "text": "a cut release with its DONE condition \u2014 every piece carrying its\nown check, measurements declared, risks qualified. entered through\nthe GATES: work enters at the LOWEST rung whose declared inputs all\nexist; missing inputs push work UP, never through. nothing passes\na gate on assertion.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a cut release with its DONE condition \u2014 every piece carrying its\nown check, measurements declared, risks qualified. entered through\nthe GATES: work enters at the LOWEST rung whose declared inputs all\nexist; missing inputs push work UP, never through. nothing passes\na gate on assertion.",
   "autoResize": true,
   "lineHeight": 1.25
  },
