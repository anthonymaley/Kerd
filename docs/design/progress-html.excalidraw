   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "ANCHOR = MODEL-DERIVED, so it converges by construction:\nnewest landed-piece commit (sha + subject, from trailer evidence)\n+ a state fingerprint (md5 of the canonical model JSON).\nboth change exactly when the picture changes; render-only\ncommits change neither. no timestamps, no HEAD, no randomness.",
   "fontSize": 13,
   "fontFamily": 6,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r1035",
   "originalText": "ANCHOR = MODEL-DERIVED, so it converges by construction:\nnewest landed-piece commit (sha + subject, from trailer evidence)\n+ a state fingerprint (md5 of the canonical model JSON).\nboth change exactly when the picture changes; render-only\ncommits change neither. no timestamps, no HEAD, no randomness.",
   "autoResize": true,
   "lineHeight": 1.25
  },
