   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the page names what it reflects - but the commit that STORES the\npage moves HEAD, so a HEAD stamp re-stales every fresh compare:\npermanent deadlock. same killer class as push-wiring's probe.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the page names what it reflects - but the commit that STORES the\npage moves HEAD, so a HEAD stamp re-stales every fresh compare:\npermanent deadlock. same killer class as push-wiring's probe.",
   "autoResize": true,
   "lineHeight": 1.25
  },
