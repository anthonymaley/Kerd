  {
   "id": "t1031",
   "type": "text",
   "x": 736.7,
   "y": 1218.25,
   "width": 446.6,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
