  {
   "id": "t1052",
   "type": "text",
   "x": 771.35,
   "y": 2229.25,
   "width": 377.3,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
