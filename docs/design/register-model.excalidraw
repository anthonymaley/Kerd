  {
   "id": "t1038",
   "type": "text",
   "x": 802.15,
   "y": 1521.25,
   "width": 315.70000000000005,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
