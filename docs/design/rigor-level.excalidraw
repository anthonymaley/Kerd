  {
   "id": "t1032",
   "type": "text",
   "x": 678,
   "y": 959,
   "width": 429.00000000000006,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
