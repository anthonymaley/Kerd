   "roundness": null,
   "text": "What every consuming project must have \u2014 measured, not read",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r1016",
   "originalText": "What every consuming project must have \u2014 measured, not read",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1018",
   "type": "text",
   "x": 678,
   "y": 574,
   "width": 429.00000000000006,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0018",
   "seed": 17126,
   "version": 1,
   "versionNonce": 33234,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "THERE IS NO MACOS INSTALL PATH.\n\nbrew search -> not found. pip3 index -> no distribution. every\nrelease ships Windows .exe only; configure.ac's *darwin* case is\nempty. macOS means an autotools compile against libzip, libxml2,\npoppler-cpp \u2014 and libpcreposix from PCRE1, whose Homebrew formula\nHomebrew itself marks deprecated: unmaintained.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "THERE IS NO MACOS INSTALL PATH.\n\nbrew search -> not found. pip3 index -> no distribution. every\nrelease ships Windows .exe only; configure.ac's *darwin* case is\nempty. macOS means an autotools compile against libzip, libxml2,\npoppler-cpp \u2014 and libpcreposix from PCRE1, whose Homebrew formula\nHomebrew itself marks deprecated: unmaintained.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t1019",
   "type": "text",
   "x": 1320,
   "y": 510,
   "width": 158.4,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0019",
   "seed": 17133,
   "version": 1,
   "versionNonce": 33247,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "this would be Kerd's\nfirst native-compiled\ndependency. that is a\ncategory change in what\na consuming project must\nown.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "this would be Kerd's\nfirst native-compiled\ndependency. that is a\ncategory change in what\na consuming project must\nown.",
   "autoResize": true,
   "lineHeight": 1.25
  },
