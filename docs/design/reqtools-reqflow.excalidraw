   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "markdown is handled only by the unknown-extension fallthrough to\nplain text \u2014 no notion of headings, frontmatter, tables or lists.\n\nno UI, no write-back, no board. report-only, one-way. it cannot\nbe the place a requirement's state changes, which is most of\nwhat a register does.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "markdown is handled only by the unknown-extension fallthrough to\nplain text \u2014 no notion of headings, frontmatter, tables or lists.\n\nno UI, no write-back, no board. report-only, one-way. it cannot\nbe the place a requirement's state changes, which is most of\nwhat a register does.",
   "autoResize": true,
   "lineHeight": 1.25
  },
