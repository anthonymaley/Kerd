   "updated": 1785400000000,
   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "no category taxonomy.\nno lifecycle states \u2014\nthe only status in the\ntool is 'U' for\nuncovered.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "no category taxonomy.\nno lifecycle states \u2014\nthe only status in the\ntool is 'U' for\nuncovered.",
