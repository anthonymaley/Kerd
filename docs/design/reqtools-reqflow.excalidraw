   "roundness": null,
   "text": "text \u00b7 CSV \u00b7 HTML. the HTML claim is true and verified in source.\n\nthe only machine-readable export is CSV \u2014 the export enum is\nliterally { REQ_X_TXT, REQ_X_CSV }. no JSON, no XML.",
   "fontSize": 12,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "text \u00b7 CSV \u00b7 HTML. the HTML claim is true and verified in source.\n\nthe only machine-readable export is CSV \u2014 the export enum is\nliterally { REQ_X_TXT, REQ_X_CSV }. no JSON, no XML.",
   "autoResize": true,
   "lineHeight": 1.25
  },
