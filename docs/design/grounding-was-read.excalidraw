   "link": null,
   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "options are not close, so\nmarks suffice - the design\ninstrument's own rule:\nscores only when close,\nweights only when criteria\ndiffer.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "options are not close, so\nmarks suffice - the design\ninstrument's own rule:\nscores only when close,\nweights only when criteria\ndiffer.",
