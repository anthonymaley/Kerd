   "roundness": null,
   "text": "for every docs/product/*.md: find_section('Grounding') ->\nabsent = vacuous pass (declaring is opting in). per '- ' line:\nsplit on the FIRST ' \u2014 '; resolve exact path, or glob with >=1\nmatch, against the repo root.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
