  {
   "id": "t1025",
   "type": "text",
   "x": 678,
   "y": 724,
   "width": 415.8,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
