      "index": "a0440",
      "seed": 20080,
      "version": 1,
      "versionNonce": 38720,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Build \u00b7 Quality \u00b7 ship the register first and treat write-back and interchange as later\nslices, generated from the markdown rather than stored in a tool's format \u00b7 temporary \u00b7\nmedium \u2014 the generator pattern for HTML is proven three times over, but no page in\n`tools/` has ever written back \u00b7 the first time the producer needs to change a\nrequirement's state without editing the file",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Build \u00b7 Quality \u00b7 ship the register first and treat write-back and interchange as later\nslices, generated from the markdown rather than stored in a tool's format \u00b7 temporary \u00b7\nmedium \u2014 the generator pattern for HTML is proven three times over, but no page in\n`tools/` has ever written back \u00b7 the first time the producer needs to change a\nrequirement's state without editing the file",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1441",
      "type": "text",
      "x": 300,
      "y": 2951,
      "width": 594.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
