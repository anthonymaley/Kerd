      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "OpenFastTrace \u00b7 The twenty-category taxonomy \u00b7 use free-form `Tags:` for category, since\nartifact types are tracing-hierarchy levels rather than an orthogonal taxonomy \u00b7 permanent\n\u00b7 low \u2014 tags are unvalidated free text, so the taxonomy would be unenforced \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenFastTrace \u00b7 The twenty-category taxonomy \u00b7 use free-form `Tags:` for category, since\nartifact types are tracing-hierarchy levels rather than an orthogonal taxonomy \u00b7 permanent\n\u00b7 low \u2014 tags are unvalidated free text, so the taxonomy would be unenforced \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1438",
      "type": "text",
      "x": 300,
      "y": 2750,
      "width": 594.0,
