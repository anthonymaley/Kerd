      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 Release grouping \u00b7 a custom release field plus `needtable` filtering to\nproduce a per-release view \u00b7 temporary \u00b7 low \u2014 this yields a filtered document, not a\nboard, and the same approach in StrictDoc was ignored by JSON export \u00b7 the first time a\nfiltered view is asked to reorder or move an item",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 Release grouping \u00b7 a custom release field plus `needtable` filtering to\nproduce a per-release view \u00b7 temporary \u00b7 low \u2014 this yields a filtered document, not a\nboard, and the same approach in StrictDoc was ignored by JSON export \u00b7 the first time a\nfiltered view is asked to reorder or move an item",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1306",
      "type": "text",
      "x": 300,
