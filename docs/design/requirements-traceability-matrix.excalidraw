      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "\u00d7  CANNOT MEET IT, even with a countermeasure \u2014 never takes a modifier, because there is no degree of impossibility",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u00d7  CANNOT MEET IT, even with a countermeasure \u2014 never takes a modifier, because there is no degree of impossibility",
      "autoResize": true,
      "lineHeight": 1.25
    },
