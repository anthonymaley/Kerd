      "versionNonce": 36952,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 Forward trace to code and tests \u00b7 link needs to source via a custom link\ntype and a code-side annotation convention \u00b7 permanent \u00b7 medium \u2014 link types are a working\nfeature; the code-side convention would be ours to invent \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 Forward trace to code and tests \u00b7 link needs to source via a custom link\ntype and a code-side annotation convention \u00b7 permanent \u00b7 medium \u2014 link types are a working\nfeature; the code-side convention would be ours to invent \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1305",
      "type": "text",
      "x": 300,
      "y": 2187,
      "width": 574.2,
      "height": 60.0,
      "angle": 0,
