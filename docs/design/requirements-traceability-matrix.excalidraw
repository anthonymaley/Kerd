      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 The same files \u00b7 rewrite the fourteen product docs into directive syntax \u00b7\npermanent \u00b7 low \u2014 the decisive test found ZERO needs in the real docs, and `needs.json` is\na build artifact, i.e. a derived second copy \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 The same files \u00b7 rewrite the fourteen product docs into directive syntax \u00b7\npermanent \u00b7 low \u2014 the decisive test found ZERO needs in the real docs, and `needs.json` is\na build artifact, i.e. a derived second copy \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1449",
      "type": "text",
      "x": 300,
      "y": 2312,
      "width": 574.2,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
