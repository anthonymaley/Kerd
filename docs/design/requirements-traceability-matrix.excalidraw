      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Doorstop \u00b7 Forward trace to code and tests \u00b7 use `links:` to a synthetic implementation\ndocument, or fall back to the `Piece:` trailer \u00b7 temporary \u00b7 low \u2014 `links:` is designed\nfor document-tier tracing, not for pointing at source files \u00b7 the first requirement that\nneeds to name the commit that satisfied it",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Doorstop \u00b7 Forward trace to code and tests \u00b7 use `links:` to a synthetic implementation\ndocument, or fall back to the `Piece:` trailer \u00b7 temporary \u00b7 low \u2014 `links:` is designed\nfor document-tier tracing, not for pointing at source files \u00b7 the first requirement that\nneeds to name the commit that satisfied it",
      "autoResize": true,
      "lineHeight": 1.25
    },
