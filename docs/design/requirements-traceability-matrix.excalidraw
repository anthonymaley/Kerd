      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "StrictDoc \u00b7 Effort \u00b7 convert the fourteen product docs once, then author only in `.sdoc` \u00b7\npermanent \u00b7 medium \u2014 round-trip is verified, but the conversion is a one-way door for\nanything that reads markdown today \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "StrictDoc \u00b7 Effort \u00b7 convert the fourteen product docs once, then author only in `.sdoc` \u00b7\npermanent \u00b7 medium \u2014 round-trip is verified, but the conversion is a one-way door for\nanything that reads markdown today \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
