      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 No artifact scatter \u00b7 gitignore `_build/` and publish the HTML from CI\nrather than committing it \u00b7 permanent \u00b7 medium \u2014 works, but the shareable artifact then\nneeds hosting that does not exist \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 No artifact scatter \u00b7 gitignore `_build/` and publish the HTML from CI\nrather than committing it \u00b7 permanent \u00b7 medium \u2014 works, but the shareable artifact then\nneeds hosting that does not exist \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1450",
      "type": "text",
      "x": 300,
      "y": 2369,
      "width": 580.8000000000001,
      "height": 60.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
