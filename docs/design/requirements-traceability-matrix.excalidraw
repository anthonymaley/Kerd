      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 Claude Code friendly \u00b7 author in MyST markdown rather than RST so a model\nedits ordinary prose \u00b7 permanent \u00b7 medium \u2014 MyST is a further install on top of an already\nheavy toolchain \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 Claude Code friendly \u00b7 author in MyST markdown rather than RST so a model\nedits ordinary prose \u00b7 permanent \u00b7 medium \u2014 MyST is a further install on top of an already\nheavy toolchain \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1434",
