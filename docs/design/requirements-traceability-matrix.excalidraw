      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "SphinxNeeds \u00b7 Category disposition \u00b7 a custom `needs_extra_options` field plus a Kerd-side\ncompleteness check \u00b7 permanent \u00b7 medium \u2014 works, but three of the documented options\nemitted deprecation warnings in 8.3.0 \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SphinxNeeds \u00b7 Category disposition \u00b7 a custom `needs_extra_options` field plus a Kerd-side\ncompleteness check \u00b7 permanent \u00b7 medium \u2014 works, but three of the documented options\nemitted deprecation warnings in 8.3.0 \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1305",
      "type": "text",
      "x": 300,
      "y": 2150,
      "width": 594.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
