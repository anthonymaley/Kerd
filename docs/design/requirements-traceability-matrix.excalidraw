      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "\u25cb  FULLY MEETS the target as it stands, nothing added        \u25cb+ comfortably  \u00b7  \u25cb- only just",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
