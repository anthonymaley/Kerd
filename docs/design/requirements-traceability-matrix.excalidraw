      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "\u25b3  MEETS IT ONLY WITH A COUNTERMEASURE, named below with a confidence        \u25b3+ cheap, likely  \u00b7  \u25b3- expensive, uncertain",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u25b3  MEETS IT ONLY WITH A COUNTERMEASURE, named below with a confidence        \u25b3+ cheap, likely  \u00b7  \u25b3- expensive, uncertain",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
