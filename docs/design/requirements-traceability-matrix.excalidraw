      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Reqflow \u00b7 Claude Code friendly \u00b7 author requirements in our own markdown and let reqflow\nregex-match them \u00b7 permanent \u00b7 low \u2014 reqflow contributes nothing to authoring; the format\nwould be entirely ours \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reqflow \u00b7 Claude Code friendly \u00b7 author requirements in our own markdown and let reqflow\nregex-match them \u00b7 permanent \u00b7 low \u2014 reqflow contributes nothing to authoring; the format\nwould be entirely ours \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1455",
      "type": "text",
      "x": 300,
      "y": 2699,
      "width": 587.4000000000001,
      "height": 45.0,
