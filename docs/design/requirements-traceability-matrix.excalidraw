      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Doorstop \u00b7 The five-state lifecycle \u00b7 validate the state field with our own checker,\nbecause Doorstop validates no custom attribute values \u00b7 permanent \u00b7 high \u2014 `state:\nBANANA_NOT_A_LIFECYCLE_STATE` passed its strictest run, so the gap is measured and the fix\nis ours \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Doorstop \u00b7 The five-state lifecycle \u00b7 validate the state field with our own checker,\nbecause Doorstop validates no custom attribute values \u00b7 permanent \u00b7 high \u2014 `state:\nBANANA_NOT_A_LIFECYCLE_STATE` passed its strictest run, so the gap is measured and the fix\nis ours \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
