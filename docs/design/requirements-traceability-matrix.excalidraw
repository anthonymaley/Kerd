      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Reqflow \u00b7 The twenty-category taxonomy \u00b7 carry the category in our own field; reqflow has\nno schema at all \u00b7 permanent \u00b7 low \u2014 a requirement is whatever a PCRE regex matched \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reqflow \u00b7 The twenty-category taxonomy \u00b7 carry the category in our own field; reqflow has\nno schema at all \u00b7 permanent \u00b7 low \u2014 a requirement is whatever a PCRE regex matched \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
