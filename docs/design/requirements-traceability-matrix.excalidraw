      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "StrictDoc \u00b7 Rating \u00b7 relax *install burden* from M to D and this becomes the live option;\nit still loses *the same files* and still has no release board \u00b7 temporary \u00b7 medium \u2014 the\ntrade is real and stated, but the decision is the producer's and has not been made \u00b7 the\nproducer rules on whether 373 MB is a fair thing to ask a consuming project to own",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "StrictDoc \u00b7 Rating \u00b7 relax *install burden* from M to D and this becomes the live option;\nit still loses *the same files* and still has no release board \u00b7 temporary \u00b7 medium \u2014 the\ntrade is real and stated, but the decision is the producer's and has not been made \u00b7 the\nproducer rules on whether 373 MB is a fair thing to ask a consuming project to own",
      "autoResize": true,
