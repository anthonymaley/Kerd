      "index": "a0298",
      "seed": 19086,
      "version": 1,
      "versionNonce": 36874,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785400000000,
      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Doorstop \u00b7 The five-state lifecycle \u00b7 validate the state field with Kerd's own checker,\nbecause Doorstop does not validate custom attribute values \u00b7 permanent \u00b7 high \u2014 `state:\nBANANA_NOT_A_LIFECYCLE_STATE` passed the strictest run, so the gap is measured and the fix\nis ours \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Doorstop \u00b7 The five-state lifecycle \u00b7 validate the state field with Kerd's own checker,\nbecause Doorstop does not validate custom attribute values \u00b7 permanent \u00b7 high \u2014 `state:\nBANANA_NOT_A_LIFECYCLE_STATE` passed the strictest run, so the gap is measured and the fix\nis ours \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1299",
      "type": "text",
      "x": 300,
      "y": 1793,
      "width": 594.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0299",
      "seed": 19093,
