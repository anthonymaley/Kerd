      "x": 300,
      "y": 2255,
      "width": 594.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0448",
      "seed": 20136,
      "version": 1,
      "versionNonce": 38824,
      "isDeleted": false,
      "boundElements": [],
