      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Reqflow \u00b7 Requirement-to-requirement dependency \u00b7 express dependency through the single\nuntyped covers / covered-by relation \u00b7 permanent \u00b7 low \u2014 one untyped relation cannot\ndistinguish dependency from coverage \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reqflow \u00b7 Requirement-to-requirement dependency \u00b7 express dependency through the single\nuntyped covers / covered-by relation \u00b7 permanent \u00b7 low \u2014 one untyped relation cannot\ndistinguish dependency from coverage \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t1440",
      "type": "text",
      "x": 300,
      "y": 2864,
      "width": 574.2,
      "height": 75.0,
      "angle": 0,
