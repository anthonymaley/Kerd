      "link": null,
      "locked": false,
      "customData": {
        "gen": "kerd"
      },
      "roundness": null,
      "text": "Reqflow \u00b7 Machine-readable by stdlib \u00b7 parse our own markdown with stdlib and use reqflow\nonly for coverage reports \u00b7 permanent \u00b7 low \u2014 its only structured export is a two-column\nCSV, produced by a binary that will not install here \u00b7 \u2014",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reqflow \u00b7 Machine-readable by stdlib \u00b7 parse our own markdown with stdlib and use reqflow\nonly for coverage reports \u00b7 permanent \u00b7 low \u2014 its only structured export is a two-column\nCSV, produced by a binary that will not install here \u00b7 \u2014",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
