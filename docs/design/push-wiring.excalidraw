   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "the two stage-1 measurements,\nANSWERED:\n\nstaleness at a push tip -> 0:\nCI refuses any differing tip.\n\nremember-steps -> 0: nothing\nremembered - forgetting yields\na refusal carrying the fix\n(fixture-checked).",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the two stage-1 measurements,\nANSWERED:\n\nstaleness at a push tip -> 0:\nCI refuses any differing tip.\n\nremember-steps -> 0: nothing\nremembered - forgetting yields\na refusal carrying the fix\n(fixture-checked).",
   "autoResize": true,
   "lineHeight": 1.25
  },
