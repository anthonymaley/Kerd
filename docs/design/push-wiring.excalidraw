   "roundness": null,
   "text": "commit -> refresh -> commit the render pair -> ONE push.\nCI step 7 byte-compares fresh vs committed at every pushed tip;\ndifferent = refused, and the message carries the exact fix.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "commit -> refresh -> commit the render pair -> ONE push.\nCI step 7 byte-compares fresh vs committed at every pushed tip;\ndifferent = refused, and the message carries the exact fix.",
