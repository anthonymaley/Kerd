   "roundness": null,
   "text": "render the pair to a TEMP dir (never the working tree) ->\nbyte-compare each against docs/plans/progress.{excalidraw,svg}\non disk. in CI, disk IS the pushed tip; locally the answer is\n'would CI refuse this tree?'. both files compared - a hand-edited\nSVG is drift too.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "render the pair to a TEMP dir (never the working tree) ->\nbyte-compare each against docs/plans/progress.{excalidraw,svg}\non disk. in CI, disk IS the pushed tip; locally the answer is\n'would CI refuse this tree?'. both files compared - a hand-edited\nSVG is drift too.",
   "autoResize": true,
   "lineHeight": 1.25
  },
