   "roundness": null,
   "text": "30 distributions / 118 MB \u2014 or 35 / 122 MB with MyST for markdown.\n\nits own diagrams need non-Python binaries: Java + plantuml.jar,\nor Graphviz. absent them, needflow bakes 'Error: PlantUML is not\navailable!' into the PUBLISHED HTML rather than failing the build.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "30 distributions / 118 MB \u2014 or 35 / 122 MB with MyST for markdown.\n\nits own diagrams need non-Python binaries: Java + plantuml.jar,\nor Graphviz. absent them, needflow bakes 'Error: PlantUML is not\navailable!' into the PUBLISHED HTML rather than failing the build.",
   "autoResize": true,
   "lineHeight": 1.25
  },
