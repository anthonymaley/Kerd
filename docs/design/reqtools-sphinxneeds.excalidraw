   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "what it DOES do, and no other external option does as well:\nUX-001 IDs \u00b7 a five-state enum \u00b7 custom dependency field \u00b7\nreq-to-req links with automatic backlinks \u00b7 needtable filtering.\nand its validation REFUSES \u2014 malformed ID, bogus status and\ndangling dependency all rejected; sphinx-build -W exits 1.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "what it DOES do, and no other external option does as well:\nUX-001 IDs \u00b7 a five-state enum \u00b7 custom dependency field \u00b7\nreq-to-req links with automatic backlinks \u00b7 needtable filtering.\nand its validation REFUSES \u2014 malformed ID, bogus status and\ndangling dependency all rejected; sphinx-build -W exits 1.",
   "autoResize": true,
