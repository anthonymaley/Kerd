   "roundness": null,
   "text": "one DIRECTORY per document, one FILE per requirement, one\n.doorstop.yml per directory. the UID is not inside the file \u2014\nit IS the filename.\n\nitem format is YAML, or markdown with YAML frontmatter. a\nstdlib-only Python script parsed every field with PyYAML NOT\ninstalled, so there is genuinely no lock-in.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "one DIRECTORY per document, one FILE per requirement, one\n.doorstop.yml per directory. the UID is not inside the file \u2014\nit IS the filename.\n\nitem format is YAML, or markdown with YAML frontmatter. a\nstdlib-only Python script parsed every field with PyYAML NOT\ninstalled, so there is genuinely no lock-in.",
   "autoResize": true,
   "lineHeight": 1.25
  },
