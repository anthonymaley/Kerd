   "locked": false,
   "customData": {
    "gen": "kerd"
   },
   "roundness": null,
   "text": "published HTML; nothing generated needs committing.\n\nbut plain `doorstop` MUTATES the source files \u2014 alphabetises keys\nand injects SHA256 fingerprints \u2014 so CI must pass -F. and the web\nserver is read-only bar one number-reservation POST.",
   "fontSize": 12,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "published HTML; nothing generated needs committing.\n\nbut plain `doorstop` MUTATES the source files \u2014 alphabetises keys\nand injects SHA256 fingerprints \u2014 so CI must pass -F. and the web\nserver is read-only bar one number-reservation POST.",
   "autoResize": true,
   "lineHeight": 1.25
  },
