{
  "description": "Kerd session hooks, auto-loaded when the plugin is enabled: surface stale state on session start and show mode progress after skill completion (both silent unless the repo carries Kerd state), and tell the session how many tokens its context holds, in every project (each prompt once a reply exists to count, and during long turns at most every five minutes or 50,000 tokens).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-complete.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-reading.sh\" tool",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/context-reading.sh\" prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
